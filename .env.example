# Database Configuration
DATABASE_URL=postgres://tg_user:password@localhost:5432/tg_analysis?sslmode=disable
CLICKHOUSE_URL=clickhouse://tg_user:password@localhost:9000/tg_analytics
REDIS_URL=redis://localhost:6379

# Telegram API Configuration
# Get these from https://my.telegram.org
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# Security Configuration
# Generate with: openssl rand -base64 32
SESSION_ENC_KEY=your_32_byte_base64_encoded_key_here
# Generate with: openssl rand -hex 16
COOKIE_SECRET=your_random_32_char_string_here

# Application Configuration
BASE_URL=http://localhost:3000
API_URL=http://localhost:8080
PORT=8080
ENV=development
TIMEZONE=Europe/Moscow

# Feature Flags
ENABLE_METRICS=false
ENABLE_PPROF=false
LOG_LEVEL=debug

# Database Passwords (for docker-compose)
POSTGRES_PASSWORD=secure_password_here
CLICKHOUSE_PASSWORD=another_secure_password